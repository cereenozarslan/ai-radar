# Bu dosyayı .env olarak kopyala ve kendi değerlerinle doldur.
# .env dosyası asla git'e commit edilmez (.gitignore içinde).

# SQLite veritabanı dosya yolu (proje köküne göre)
DATABASE_PATH=data/ai_radar.db

# X (Twitter) API - sadece okuma/arama için bearer token yeterli
X_BEARER_TOKEN=
# Tweet atma/kullanıcı adına işlem gerekirse ileride lazım olabilir, şimdilik kullanılmıyor
X_API_KEY=
X_API_SECRET=
# "Takip ettiklerinin gündemi" özelliği için kendi X kullanıcı adınız (başında @ olmadan)
X_FOLLOW_USERNAME=

# YouTube Data API v3 - takip edilen konularla ilgili video önerileri için.
# console.cloud.google.com üzerinden ücretsiz alınır (kredi kartı gerekmez).
YOUTUBE_API_KEY=

# Sonraki fazlarda eklenecek anahtarlar (şimdilik gerekmiyor):
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=
# ANTHROPIC_API_KEY=
# OBSIDIAN_VAULT_PATH=
