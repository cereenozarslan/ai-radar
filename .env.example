# Bu dosyayı .env olarak kopyala ve kendi değerlerinle doldur.
# .env dosyası asla git'e commit edilmez (.gitignore içinde).

# SQLite veritabanı dosya yolu (proje köküne göre)
DATABASE_PATH=data/ai_radar.db

